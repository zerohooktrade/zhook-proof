{
  "name": "@zerohooktrade/proof",
  "version": "0.1.0",
  "description": "Proof of Execution for Robinhood Chain swaps: a spec, a verifier library and a CLI that measure a swap against the best Uniswap-only route at the same block.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.zerohook.trade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerohooktrade/zhook-proof.git"
  },
  "bugs": "https://github.com/zerohooktrade/zhook-proof/issues",
  "keywords": [
    "zerohook",
    "proof-of-execution",
    "uniswap",
    "uniswap-v4",
    "robinhood-chain",
    "best-execution",
    "viem"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "bin": {
    "zhook-proof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vectors",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts",
    "record": "tsx scripts/record.ts"
  },
  "dependencies": {
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
